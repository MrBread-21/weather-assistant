# Mẫu biến môi trường cho weather-assistant.
# Trên SERVER: chép file này thành /etc/weather-assistant.env rồi điền giá trị.
#   sudo cp weather-assistant.env.example /etc/weather-assistant.env
#   sudo nano /etc/weather-assistant.env
# ĐỪNG commit file có giá trị thật — nó chứa API key.

# --- Gợi ý AI (tuỳ chọn) ---
# Key gọi Claude. Để trống = tắt gợi ý AI, app vẫn chạy phần thời tiết.
ANTHROPIC_API_KEY=

# Đổi model nếu muốn. Mặc định claude-opus-5-5. Rẻ hơn nhiều: claude-haiku-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Thông báo về điện thoại (ntfy) ---
# Đặt 1 chuỗi KHÓ ĐOÁN như mật khẩu (ai biết topic cũng gửi/nhận được).
# Rồi mở app ntfy trên điện thoại -> Subscribe -> nhập ĐÚNG chuỗi này.
NTFY_TOPIC=mrbread-weather-DOI-CHUOI-NAY-cho-ngau-nhien

# Tự host ntfy thì đổi URL. Mặc định dịch vụ công:
# NTFY_SERVER=https://ntfy.sh

# --- Google Calendar (tuỳ chọn) ---
# Nối lịch để AI nhắc khi sự kiện trùng lúc trời mưa. Để trống cả 3 dòng = tắt tính năng.
# Lấy client id/secret bằng cách tạo OAuth client (Web application) trong Google Cloud Console.
# GCAL_REDIRECT_URI phải trùng Y HỆT cái khai trong Google Console.
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REDIRECT_URI=https://mrbread.tail10f69f.ts.net/api/gcal/callback
